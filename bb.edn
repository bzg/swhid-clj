{:paths ["src" "test"]
 :tasks
 {test
  {:doc "Run the test suite under Babashka"
   :requires ([clojure.test :as t])
   :task (do
           (require 'swhid.core-test 'swhid.qualifier-test 'swhid.hash-test 'swhid.git-test)
           (let [{:keys [fail error]}
                 (t/run-tests 'swhid.core-test 'swhid.qualifier-test 'swhid.hash-test 'swhid.git-test)]
             (System/exit (if (pos? (+ fail error)) 1 0))))}}}
